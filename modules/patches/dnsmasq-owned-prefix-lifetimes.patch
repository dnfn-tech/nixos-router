+/* The independent manager stops this service before removing its bridge.
+   Withdraw constructed prefixes while the interface and RA socket still exist. */
+void ra_shutdown(time_t now)
+{
+  struct dhcp_context *context;
+
+  if (daemon->icmp6fd == -1)
+    return;
+
+  ra_stopping = 1;
+  for (context = daemon->dhcp6; context; context = context->next)
+    if ((context->flags & CONTEXT_CONSTRUCTED) &&
+        ((context->flags & CONTEXT_RA) || option_bool(OPT_RA)))
+      {
+        context->flags |= CONTEXT_OLD;
+        context->saved_valid = 0;
+        context->address_lost_time = now;
+        context->ra_time = now;
+      }
+
+  /* Send synchronously: the normal unsolicited timer cannot run after exit. */
+  periodic_ra(now);
+}
